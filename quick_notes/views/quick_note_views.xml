<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_x_custom_quick_note_list" model="ir.ui.view">
        <field name="name">x_custom.quick_note.list</field>
        <field name="model">x_custom.quick_note</field>
        <field name="arch" type="xml">
            <list string="Quick Notes"
                  decoration-success="status == 'completed'"
                  decoration-warning="status == 'pending'">
                <field name="name"/>
                <field name="description" optional="show"/>
                <field name="created_date"/>
                <field name="status" widget="badge"
                       decoration-warning="status == 'pending'"
                       decoration-success="status == 'completed'"/>
            </list>
        </field>
    </record>

    <record id="view_x_custom_quick_note_form" model="ir.ui.view">
        <field name="name">x_custom.quick_note.form</field>
        <field name="model">x_custom.quick_note</field>
        <field name="arch" type="xml">
            <form string="Quick Note">
                <header>
                    <button name="action_mark_completed"
                            string="Mark as Completed"
                            type="object"
                            class="btn-primary"
                            invisible="status == 'completed'"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="pending,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Note title"/>
                        </h1>
                    </div>
                    <group>
                        <field name="created_date"/>
                    </group>
                    <group>
                        <field name="description" placeholder="Write your note here..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_x_custom_quick_note_search" model="ir.ui.view">
        <field name="name">x_custom.quick_note.search</field>
        <field name="model">x_custom.quick_note</field>
        <field name="arch" type="xml">
            <search string="Search Quick Notes">
                <field name="name"/>
                <field name="description"/>
                <filter name="pending" string="Pending"
                        domain="[('status', '=', 'pending')]"/>
                <filter name="completed" string="Completed"
                        domain="[('status', '=', 'completed')]"/>
                <separator/>
                <filter name="group_by_status" string="Status"
                        context="{'group_by': 'status'}"/>
            </search>
        </field>
    </record>

    <record id="action_x_custom_quick_notes" model="ir.actions.act_window">
        <field name="name">Quick Notes</field>
        <field name="res_model">x_custom.quick_note</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_x_custom_quick_note_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first quick note</p>
            <p>Capture a note and mark it as completed when it is done.</p>
        </field>
    </record>

    <menuitem id="menu_quick_notes_root"
              name="Quick Notes"
              sequence="20"/>
    <menuitem id="menu_x_custom_quick_notes"
              name="Notes"
              parent="menu_quick_notes_root"
              action="action_x_custom_quick_notes"
              sequence="10"/>
</odoo>
